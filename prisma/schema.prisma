datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client-js"
}

model Image {
  id           String   @id @default(cuid())
  hash         String   @unique
  originalName String
  storedName   String // hash-nome-original
  mimeType     String
  size         Int
  driveFileId  String   @unique
  driveViewUrl String
  createdAt    DateTime @default(now())
}
